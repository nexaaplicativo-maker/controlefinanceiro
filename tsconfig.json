{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `mcp` fora: e um projeto separado, com o proprio tsconfig e as proprias
  // dependencias. Como o `include` acima varre todo .ts do repositorio, sem
  // esta linha o `next build` tenta compilar o servidor MCP com as opcoes do
  // app — outro target, outro moduleResolution — e quebra o build da Vercel.
  "exclude": ["node_modules", "mcp"]
}
